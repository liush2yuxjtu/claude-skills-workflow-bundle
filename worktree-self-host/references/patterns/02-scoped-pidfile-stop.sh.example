# Pattern 2: Scoped stop via per-worktree pidfiles
#
# Why: the canonical `make dev` `stop_all` uses `pkill -f "uvicorn ... 8001"` or
# `_kill_port 8001` — both are unscoped, so launching worktree A tears down
# worktree B's services. The fix is to record each service's PID in a file
# under $REPO_ROOT/.run/, and only kill those PIDs on stop.
#
# What goes in .run/:
#   gateway.pid   gateway.port
#   frontend.pid  frontend.port
#   nginx.pid     nginx.port
#
# All paths under $REPO_ROOT so they're per-worktree by construction.

# When starting a service: capture the listener's actual PID (not the shell
# subshell that backgrounded it — that subshell exits in milliseconds and
# the pidfile would point at a dead pid).
#
# Trick: the launcher writes the subshell's PID initially, then after the
# port is up, re-reads lsof for the actual listener PID and patches the
# pidfile. For services that write their own pid file (e.g. nginx's
# `pid` directive, or any daemon that does `daemonize`), prefer that.

mkdir -p "$REPO_ROOT/.run"

# Approach 1: lsof-patch (works for anything listening on a TCP port)
patch_via_lsof() {
    local name="$1" port="$2" shell_pid="$3"
    echo "$shell_pid" > "$REPO_ROOT/.run/$name.pid"  # initial; will be overwritten
    bash "$REPO_ROOT/scripts/wait-for-port.sh" "$port" 30 "$name" || {
        echo "$name failed to start"; return 1
    }
    local real_pid
    real_pid=$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -1 || true)
    if [ -n "$real_pid" ]; then
        echo "$real_pid" > "$REPO_ROOT/.run/$name.pid"
    fi
}

# Approach 2: read the service's own pid file (for daemons like nginx, postgres)
patch_via_pidfile() {
    local name="$1" port="$2" pidfile="$3" shell_pid="$4"
    echo "$shell_pid" > "$REPO_ROOT/.run/$name.pid"
    bash "$REPO_ROOT/scripts/wait-for-port.sh" "$port" 30 "$name" || return 1
    if [ -f "$pidfile" ]; then
        cp "$pidfile" "$REPO_ROOT/.run/$name.pid"
    fi
}

# Stop: TERM each, escalate to KILL after 5s, then clear. Run in parallel
# (services are independent at kill time → capped at 5s, not 15s).
stop_scoped() {
    local _pids=()
    for svc in gateway frontend nginx; do
        (
            pid=$(cat "$REPO_ROOT/.run/$svc.pid" 2>/dev/null || true)
            [ -z "$pid" ] && exit 0
            kill -0 "$pid" 2>/dev/null || { rm -f "$REPO_ROOT/.run/$svc.pid"; exit 0; }
            kill -TERM "$pid" 2>/dev/null || true
            for _ in 1 2 3 4 5; do
                kill -0 "$pid" 2>/dev/null || break
                sleep 1
            done
            kill -KILL "$pid" 2>/dev/null || true
            rm -f "$REPO_ROOT/.run/$svc.pid"
        ) &
        _pids+=($!)
    done
    wait "${_pids[@]}" 2>/dev/null || true
}

# NEVER do this in a per-worktree launcher:
#   pkill -f "uvicorn.*8001"   # too broad — kills sibling worktrees
#   fuser -k 8001/tcp          # too broad — kills sibling worktrees
#   _kill_port 8001            # too broad — kills sibling worktrees
